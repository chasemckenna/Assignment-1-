def get_tax_bracket(income):
    if income < 0:
        return "Invalid income."
    elif income < 50000:
        bracket = "Low (10%)"
    elif income < 100000:
        bracket = "Medium (20%)"
    else:
        bracket = "High (30%)"

income = float(input("What's your annual income? "))
bracket = get_tax_bracket(income)
 
if income < 0:
    print(bracket)
else:
